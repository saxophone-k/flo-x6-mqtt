# --- MQTT (point this at YOUR broker) ---
FLO_MQTT_HOST=192.168.10.100
FLO_MQTT_PORT=1883
FLO_MQTT_USER=
FLO_MQTT_PASS=

# --- OCPP server (the port your charger will connect to) ---
FLO_OCPP_PORT=9000
FLO_HEARTBEAT_INTERVAL=30

# --- Home Assistant identity ---
FLO_DEVICE_NAME=Flo Home X6
FLO_DEVICE_ID=flo_x6
FLO_MQTT_PREFIX=flo-x6
FLO_HA_DISCOVERY_PREFIX=homeassistant

FLO_LOG_LEVEL=INFO
